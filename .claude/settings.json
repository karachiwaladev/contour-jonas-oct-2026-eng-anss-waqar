{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(sudo rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push * --force-with-lease)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | sudo sh)",
      "Bash(curl * | sudo bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Bash(cat */.env)",
      "Bash(cat */.env.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.env)",
      "Read(~/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
